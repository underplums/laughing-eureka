   "source": [
    "quantile_bins = pd.qcut(\n",
    "    merged_scores['score'],\n",
    "    q=10,\n",
    "    duplicates='drop'\n",
    ")\n",
    "\n",
    "bin_edges = quantile_bins.cat.categories\n",
    "\n",
    "merged_scores['score_bin'] = pd.cut(\n",
    "    merged_scores['score'],\n",
    "    bins=[x.left for x in bin_edges] + [bin_edges[-1].right],\n",
    "    include_lowest=True\n",
    ")"
   ]
  }
 ],
